---
layout: base.njk
title: Portfolio — Home
---
    <main id="main-content" class="site-main">
      <section class="section section--hero hero" id="about" data-hero-debug="off">
        <div class="container container--wide hero__wrapper">
          <div class="hero__grid">
            <h1 class="type-display-xl hero__headline">
              Multidisciplinary designer with a passion for exploring and producing new kinds of meaning.
            </h1>
          </div>

          <div class="hero__profile" aria-hidden="true">
            {% progressiveImage "/assets/figma/Image Profile.png", "Portrait illustration of Vladimir Pushkarev", 326, 326, "", "", "", "async", "high" %}
          </div>

          <div class="hero__grid">
            <p class="type-caption hero__caption prose">
              This illustration of me made by
              <a class="link-underline link-caption" href="https://www.instagram.com/manikhin/" target="_blank" rel="noopener noreferrer">Roman Manikhin</a>
            </p>
            <p class="type-body-lg hero__description prose">
              My skills and interests revolve around web and apps, with a focus on editorial, technology, AI, culturally
              and socially meaningful projects. The work involves creating small stories as well as building complete
              platforms, organizing small teams, and setting up processes.
            </p>
          </div>
        </div>
        <div class="hero__glow" aria-hidden="true"></div>
      </section>

      <!-- Figma 481:111 / 1294 Subheader — top padding + label; px 24; centered; no block-end padding -->
      <section class="section" id="work">
        <div class="container container--wide">
          <p class="type-caps">Featured Stories</p>
        </div>
      </section>

      <div class="projects-area">
      <div class="project-background-stage-shell" aria-hidden="true">
        <div class="project-background-stage">
          <div class="project-background-layer project-background-layer--base"></div>
          <div class="project-background-layer" data-bg-layer="prelude"></div>
          <div class="project-background-layer" data-bg-layer="featured"></div>
          <div class="project-background-layer" data-bg-layer="madebymad"></div>
          <div class="project-background-layer" data-bg-layer="odds"></div>
          <div class="project-background-layer" data-bg-layer="curves"></div>

          <div class="project-background-art project-background-art--featured" data-art-for="featured">
            <div class="project-background-art__inner">
              {% progressiveImage "/assets/figma/Section/Schrift Collective Background.svg", "", 1336, 996, "", "", "lazy", "async" %}
            </div>
          </div>

          <div class="project-background-art project-background-art--madebymad" data-art-for="madebymad">
            <div class="project-background-art__inner">
              {% progressiveImage "/assets/figma/Bike.png", "", 1428, 1060, "", "", "lazy", "async" %}
            </div>
          </div>

          <div class="project-background-art project-background-art--odds" data-art-for="odds">
            <div class="project-background-art__inner">
              <div id="humans-shader-stage" class="humans-shader-slot" aria-hidden="true"></div>
            </div>
          </div>

          <div class="project-background-art project-background-art--curves" data-art-for="curves">
            <div class="project-background-art__inner">
              {% progressiveImage "/assets/figma/Image In Curves.svg", "", 2185, 1448, "", "", "lazy", "async" %}
            </div>
          </div>
        </div>
      </div>

      <section class="section section--featured" aria-label="Schrift Collective" data-project="featured">
        <div class="section-header">
          <div class="section-header__art" aria-hidden="true">
            {% progressiveImage "/assets/figma/Section/Schrift Collective Background.svg", "", 1336, 996, "", "", "lazy", "async" %}
          </div>
          <div class="container container--wide section-header__content">
            <div class="section-header__intro">
              <h2 class="type-display-2xl section-title">Schrift Collective</h2>
              <p class="type-body-lg prose section-title">
                Works for a collective captivated by typography—from managing socials content to organizing a small
                team and developing a design system
              </p>
            </div>
            <p class="type-caption section-header__meta">Web, Ecommerce, Design system, Webflow</p>
          </div>
        </div>

        <div class="cards-grid cards-grid--schrift container--fullbleed">
          <article class="card card--schrift-foundry" aria-labelledby="project-schrift-foundry" data-reveal="scale">
            <a class="card__link" href="{{ "/schrift-foundry/" | url }}">
              <div class="card__clip">
                <div class="card__media media--schrift-foundry">
                  {% progressiveImage "/assets/figma/card-skrift-foundry.png", "Schrift Foundry project preview", 1095, 698, "", "", "lazy", "async" %}
                </div>
                <div class="card__tag">
                  <div class="tag"><h3 id="project-schrift-foundry" class="type-caption tag__text">Schrift Foundry</h3></div>
                </div>
              </div>
            </a>
          </article>

          <article class="card card--top2019" aria-labelledby="project-top-2019" data-reveal="scale">
            <a class="card__link" href="{{ "/top-2019/" | url }}">
              <div class="card__clip">
                <div class="card__media media--top2019">
                  {% progressiveImage "/assets/figma/Image Top 2019.svg", "Top 2019 project preview", 603, 603, "", "", "lazy", "async" %}
                </div>
                <div class="card__tag">
                  <div class="tag"><h3 id="project-top-2019" class="type-caption tag__text">Top 2019</h3></div>
                </div>
              </div>
            </a>
          </article>

          <article class="card card--schrift-publishers" aria-labelledby="project-schrift-publishers" data-reveal="scale">
            <div class="card__clip">
              <div class="card__media media--schrift-publishers">
                {% progressiveImage "/assets/figma/card-skrift-publishers.png", "Schrift Publishers project preview", 1095, 600, "", "", "lazy", "async" %}
              </div>
              <div class="card__tag">
                <div class="tag"><h3 id="project-schrift-publishers" class="type-caption tag__text">Schrift Publishers</h3></div>
              </div>
            </div>
          </article>

          <article class="card card--specimen" aria-labelledby="project-specimen" data-reveal="scale">
            <div class="card__clip">
              <div class="card__media media--specimen">
                {% progressiveImage "/assets/figma/card-specimen.png", "Specimen project preview", 480, 678, "", "", "lazy", "async" %}
              </div>
              <div class="card__tag">
                <div class="tag"><h3 id="project-specimen" class="type-caption tag__text">Specimen</h3></div>
              </div>
            </div>
          </article>

          <article class="card card--schrift-shop" aria-labelledby="project-schrift-shop" data-reveal="scale">
            <a class="card__link" href="{{ "/schrift-shop/" | url }}">
              <div class="card__clip">
                <div class="card__media media--schrift-shop">
                  {% progressiveImage "/assets/figma/card-skrift-shop.png", "Schrift Shop project preview", 1095, 661, "", "", "lazy", "async" %}
                </div>
                <div class="card__tag">
                  <div class="tag"><h3 id="project-schrift-shop" class="type-caption tag__text">Schrift Shop</h3></div>
                </div>
              </div>
            </a>
          </article>
        </div>
      </section>

      <section class="section section--madebymad" aria-label="Made by Mad" data-project="madebymad">
        <div class="section-header">
          <div class="section-header__art" aria-hidden="true">
            {% progressiveImage "/assets/figma/Bike.png", "", 1428, 1060, "", "", "lazy", "async" %}
          </div>
          <div class="container container--wide section-header__content">
            <div class="section-header__intro">
              <h2 class="type-display-2xl section-title">Made by Mad</h2>
              <p class="type-body-lg prose section-title">
                Product works for a full-stack digital agency, spanning design systems, food tech, telecom, and the
                redesign of the studio’s own website
              </p>
            </div>
            <p class="type-caption section-header__meta">Web, App, Design system, AI, Branding</p>
          </div>
        </div>

        <div class="cards-grid cards-grid--mad container--fullbleed">
          <article class="card card--humans" aria-labelledby="project-humans" data-reveal="scale">
            <a class="card__link" href="{{ "/humans/" | url }}">
              <div class="card__clip">
                <div class="card__media media--humans">
                  {% progressiveImage "/assets/figma/Humans/hero.png", "Humans project preview", 1464, 1228, "", "", "lazy", "async" %}
                </div>
                <div class="card__tag">
                  <div class="tag"><h3 id="project-humans" class="type-caption tag__text">Humans</h3></div>
                </div>
              </div>
            </a>
          </article>

          <article class="card card--mybox" aria-labelledby="project-mybox" data-reveal="scale">
            <a class="card__link" href="{{ "/mybox/" | url }}">
            <div class="card__clip">
              <div class="card__media media--mybox">
                {% progressiveImage "/assets/figma/mybox/Illustration 05.png", "Mybox project preview", 3396, 3396, "", "", "lazy", "async" %}
              </div>
              <div class="card__tag">
                <div class="tag"><h3 id="project-mybox" class="type-caption tag__text">Mybox</h3></div>
              </div>
            </div>
            </a>
          </article>

          <article class="card card--madebymad" aria-labelledby="project-made-by-mad" data-reveal="scale">
            <a class="card__link" href="{{ "/made-by-mad/" | url }}">
              <div class="card__clip">
                <div class="card__media media--madebymad">
                  {% progressiveImage "/assets/figma/Made by Mad/ARTD C04 Device 035.jpg", "Made by Mad studio project preview", 1464, 803, "", "", "lazy", "async" %}
                </div>
                <div class="card__tag">
                  <div class="tag"><h3 id="project-made-by-mad" class="type-caption tag__text">Made by Mad</h3></div>
                </div>
              </div>
            </a>
          </article>

        </div>
      </section>

      <section class="section section--odds" aria-label="Odds & Ends" data-project="odds">
        <div id="humans-shader" class="section--odds__shader humans-shader-slot" aria-hidden="true"></div>
        <div class="section-header">
          <div class="container container--wide section-header__content">
            <div class="section-header__intro">
              <h2 class="type-display-2xl section-title">Odds &amp; Ends</h2>
              <p class="type-body-lg prose section-title">
                Pet projects, experiments, and other work that does not fit neatly into a single category, but still
                deserves a place here
              </p>
            </div>
            <p class="type-caption section-header__meta">Editorial, Vibe-coded, Prompting</p>
          </div>
        </div>

        <div class="cards-grid cards-grid--odds container--fullbleed">
          <article class="card card--particle-text" aria-labelledby="project-particle-text" data-reveal="scale">
            <a class="card__link" href="{{ "/particle-text/" | url }}">
