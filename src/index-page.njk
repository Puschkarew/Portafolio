---
layout: base.njk
title: Portfolio — Index
permalink: /index/
---
    <main id="main-content" class="site-main">
      <section class="section section--hero hero index-hero" aria-label="Index hero">
        <div class="container container--wide index-hero__wrapper">
          <div class="index-hero__grid">
            <h1 class="type-display-xl index-hero__headline">
              <span class="index-hero__kicker">Index.</span>
              <span> A whole life in one table</span>
            </h1>
          </div>
        </div>
        <div class="index-hero__glow" aria-hidden="true"></div>
      </section>

      <section class="section index-table" aria-label="Index table">
        <div class="container container--wide">
          <ul class="index-table__list">
            <li class="index-table__item index-table__item--head">
              <div class="index-table__line index-table__line--head type-body-lg">
                <div class="index-table__grid index-table__grid--head">
                  <span class="index-table__cell index-table__cell--year">Year</span>
                  <span class="index-table__cell index-table__cell--num">#</span>
                  <span class="index-table__cell index-table__cell--name">Name</span>
                  <span class="index-table__cell index-table__cell--agency">Agency</span>
                  <span class="index-table__cell index-table__cell--type">Type</span>
                  <span class="index-table__cell index-table__cell--viewcase" aria-hidden="true"></span>
                </div>
              </div>
            </li>

            {%- for row in indexTable -%}
              {%- set showYear = loop.first or (indexTable[loop.index0 - 1].year != row.year) -%}
              {%- set hasLink = row.caseUrl -%}
              {%- set dividerMod = "index-table__divider-bar--from-year" if showYear else "index-table__divider-bar--from-num" -%}
            <li class="index-table__item{% if not showYear %} index-table__item--same-year{% endif %}{% if not hasLink %} index-table__item--no-viewcase{% endif %}" data-index-divider-start="{% if showYear %}0{% else %}1{% endif %}">
              {%- if hasLink -%}
              <a class="index-table__line index-table__line--row index-table__line--linked type-body-lg" href="{{ row.caseUrl | url }}" aria-label="{{ row.name }}, {{ row.year }}">
              {%- else -%}
              <div class="index-table__line index-table__line--row type-body-lg">
              {%- endif -%}
                <div class="index-table__divider-row" aria-hidden="true">
                  <span class="index-table__divider-bar {{ dividerMod }}"></span>
                </div>
                <div class="index-table__grid">
                  <span class="index-table__cell index-table__cell--year">{%- if showYear -%}{{ row.year }}{%- endif -%}{%- if not showYear -%}<span class="index-table__year--mobile-fill">{{ row.year }}</span>{%- endif -%}</span>
                  <span class="index-table__cell index-table__cell--num">{{ row.num }}</span>
                  <span class="index-table__cell index-table__cell--name">{{ row.name }}</span>
                  <span class="index-table__cell index-table__cell--agency">{{ row.agency }}</span>
                  <span class="index-table__cell index-table__cell--type">{{ row.type }}</span>
                  <span class="index-table__cell index-table__cell--viewcase">
                    {%- if hasLink -%}
                    <span class="index-table__viewcase-label" aria-hidden="true">View case</span>
                    {%- endif -%}
                  </span>
                </div>
              {%- if hasLink -%}
              </a>
              {%- else -%}
              </div>
              {%- endif -%}
            </li>
            {%- endfor -%}
          </ul>
        </div>
      </section>

    </main>
