      <section class="section section--hero hero case-hero case-hero--mos" aria-labelledby="mos-title" data-hero-debug="off">
        <div class="case-hero__panel case-hero__media-panel">
          <figure class="case-hero__media">
            <img src="{{ "/assets/figma/MOS/Hero.svg" | url }}" alt="MOS typeface hero collage with a large white serif letter g on black" width="1440" height="939" decoding="async" fetchpriority="high" />
          </figure>
