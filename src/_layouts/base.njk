<!doctype html>
<html lang="{{ lang | default(site.lang) }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title | default(site.title) }}</title>
    <meta name="description" content="{{ description | default(site.description) }}" />
    <meta name="author" content="{{ site.author | default(site.name) }}" />
{% if robots %}
    <meta name="robots" content="{{ robots }}" />
{% endif %}
    <link rel="canonical" href="{{ site.url }}{{ (canonical | default(page.url)) | url }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:type" content="{{ ogType | default("website") }}" />
    <meta property="og:title" content="{{ title | default(site.title) }}" />
    <meta property="og:description" content="{{ description | default(site.description) }}" />
    <meta property="og:url" content="{{ site.url }}{{ (canonical | default(page.url)) | url }}" />
    <meta property="og:image" content="{{ site.url }}{{ (image | default(site.image)) | url }}" />
    <meta property="og:image:alt" content="{{ imageAlt | default(site.imageAlt) }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title | default(site.title) }}" />
    <meta name="twitter:description" content="{{ description | default(site.description) }}" />
    <meta name="twitter:image" content="{{ site.url }}{{ (image | default(site.image)) | url }}" />
    <meta name="theme-color" content="{{ site.themeColor }}" />
    <link rel="icon" href="{{ "/assets/favicon.svg" | url }}" type="image/svg+xml" />
    <link rel="stylesheet" href="{{ "/styles/fonts.css" | url }}" />
    <link rel="stylesheet" href="{{ "/styles/tokens.css" | url }}" />
    <link rel="stylesheet" href="{{ "/styles/layout.css" | url }}" />
    <link rel="stylesheet" href="{{ "/styles/components.css" | url }}" />
    <link rel="stylesheet" href="{{ "/styles/project-background.css" | url }}" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
{{ content | safe }}
    <footer id="contact" class="site-footer section section--footer">
      <div class="container container--wide footer__wrapper">
        <div class="footer__message-grid">
          <p class="type-display-xl footer__message">Open to suggestions. <strong><a class="footer__cta" href="mailto:puschkarev.vv@gmail.com">Drop me a line</a></strong></p>
        </div>

        <div class="footer__meta-grid">
          <div id="footer-meta" class="type-caption footer__meta">
            <p>
              American Grotesk by <strong><a class="footer__meta-link" href="https://klim.co.nz/" target="_blank" rel="noopener noreferrer">Klim Type Foundry</a></strong><br />
              Society by <strong><a class="footer__meta-link" href="https://www.allcapstype.com/" target="_blank" rel="noopener noreferrer">AllCaps</a></strong>
            </p>
            <p id="contact-details">
              <time datetime="{{ build.siteBuildAtIso }}" data-site-build-time>{{ build.siteBuildLabel }}</time>
            </p>
          </div>
        </div>

        <div class="footer__model" aria-hidden="true">
          {% progressiveImage "/assets/figma/footer-model.png", "", 1752, 1800, "", "", "lazy", "async" %}
        </div>
      </div>
    </footer>

    <div class="site-header-glass" aria-hidden="true">
{% if headerVariant == "case" %}
      <div class="site-header-glass__item" data-header-glass-item="project"></div>
{% endif %}
      <div class="site-header-glass__item" data-header-glass-item="nav"></div>
      <div class="site-header-glass__item" data-header-glass-item="contact"></div>
      <div class="site-header-glass__item" data-header-glass-item="mobile"></div>
    </div>

    <div
      class="mobile-menu"
      role="dialog"
      aria-modal="true"
      aria-label="Site menu"
      hidden
    >
      <div class="mobile-menu__inner">
        <div class="mobile-menu__header">
          <button class="mobile-menu__close type-caption" type="button">
            <span class="mobile-menu__close-text">Close</span>
          </button>
        </div>

        <nav class="mobile-menu__nav" aria-label="Mobile">
          <ul class="mobile-menu__list">
            <li><a class="mobile-menu__link type-display-xl" href="{{ "/about/" | url }}">About</a></li>
            <li><a class="mobile-menu__link type-display-xl" href="{{ "/index/" | url }}">Index</a></li>
            <li><a class="mobile-menu__link type-display-xl" href="{{ "/CV/Vladimir%20Puschkarew%20CV.pdf" | url }}" target="_blank" rel="noopener noreferrer">CV</a></li>
            <li><a class="mobile-menu__link type-display-xl" href="mailto:puschkarev.vv@gmail.com">Get in touch</a></li>
          </ul>
        </nav>
      </div>
    </div>

    <header class="site-header">
      <div class="site-header__pin">
        <div class="site-header__grid">
{% if headerVariant == "case" %}
          <a class="nav-link site-header__project" href="#top"><span class="site-header__text">{{ title }}</span></a>
{% endif %}
          <div class="site-header__menu">
            <nav class="site-header__nav" aria-label="Primary">
              <ul class="site-header__list">
                <li>
                  <a class="nav-link site-header__link" href="{{ "/" | url }}"><span class="site-header__text">Vladimir Pushkarev</span></a>
                </li>
                <li>
                  <a class="nav-link site-header__link" href="{{ "/about/" | url }}"><span class="site-header__text">About</span></a>
                </li>
                <li>
                  <a class="nav-link site-header__link" href="{{ "/index/" | url }}"><span class="site-header__text">Index</span></a>
                </li>
                <li>
                  <a class="nav-link site-header__link" href="{{ "/CV/Vladimir%20Puschkarew%20CV.pdf" | url }}" target="_blank" rel="noopener noreferrer"><span class="site-header__text">CV</span></a>
                </li>
              </ul>
            </nav>
            <a class="nav-link site-header__contact" href="mailto:puschkarev.vv@gmail.com"><span class="site-header__text">Get in touch</span></a>
            <a class="nav-link site-header__mobile-trigger" href="#work"><span class="site-header__text">Menu</span></a>
          </div>
        </div>
      </div>
    </header>
    </div>

    <script src="{{ "/scripts/hero-sticky-behavior.js" | url }}" defer></script>
    <script src="{{ "/scripts/header-theme.js?v=no-header-themes" | url }}" defer></script>
    <script src="{{ "/scripts/mobile-menu.js" | url }}" defer></script>
    <script src="{{ "/assets/humans-shader/humans-shader-embed.js" | url }}" defer></script>
    <script src="{{ "/scripts/odds-humans-shader-init.js" | url }}" defer></script>
    <script src="{{ "/scripts/progressive-image.js" | url }}" defer></script>
    <script src="{{ "/scripts/project-sticky-background.js?v=no-header-themes" | url }}" defer></script>
    <script src="{{ "/scripts/scroll-reveal.js?v=caselayout-media-reveal" | url }}" defer></script>
    <script src="{{ "/scripts/site-build-local-time.js" | url }}" defer></script>
    <script src="{{ "/scripts/schrift-shop-slideshow.js?v=slideshow-decode-cut" | url }}" defer></script>
    <script src="{{ "/scripts/top-2019-hero.js" | url }}" defer></script>
  </body>
</html>
