        <div class="case-hero__panel case-hero__media-panel">
          <figure class="case-hero__media">
            <img src="{{ "/assets/figma/mybox/case-mybox-hero.png" | url }}" alt="MyBox app mockup on an orange chair, showing a sushi delivery product screen" width="1024" height="562" decoding="async" fetchpriority="high" />
